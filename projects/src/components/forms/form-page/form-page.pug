mixin form-page(i) 
    - var idForm = i.id ? `${i.id}` : `${i.cl}` //- id не обязательный параметр, если не указан подставляется имя класса как id
    div(class = `${i.cl}` id=`${idForm}`)&attributes(attributes)

        div(class = `${i.cl}__field`)
            +text-field({
                id: `${idForm}-name`,
                name: 'name',
                caption: 'Имя',
                checks: 'require',
                fieldName: 'ffield'
            })

        div(class = `${i.cl}__field`)
            +text-field({
                id: `${idForm}-phone`,
                name: 'phone',
                caption: 'Телефон',
                checks: 'require, phone',
                fieldName: 'ffield'
            })

        div(class = `${i.cl}__field`)
            +text-field({
                id: `${idForm}-email`,
                name: 'email',
                caption: 'E-mail',
                checks: 'require, email',
                fieldName: 'ffield'
            })

        div(class = `${i.cl}__field`)
            +textarea({
                id: `${idForm}-message`,
                name: 'message',
                caption: 'Сообщение',
                fieldName: 'ffield'
            })

        div(class = `${i.cl}__field`)
            +select({
                id: `${idForm}-select`,
                name: 'select',
                caption: 'Удобное время для звонка',
                value: 'after16',
                list: [
                    {name: '8:00 - 12:00'},
                    {name: '12:00 - 16:00'},
                    {name: 'после 16:00', value: 'after16'}
                ],
                fieldName: 'ffield'
            })

        div(class = `${i.cl}__field`)
            +file-field({
                id: `${idForm}-file`,
                name: 'file',
                caption: 'Выбрать файлы',
                checks: 'file-size',
                fieldName: 'ffield',
                multiple: true
            })

        div(class = `${i.cl}__field`)
            +checkbox({
                id: `${idForm}-policy`,
                name: 'policy',
                caption: `Я прочитал и согласен с правилами <a ${modxConfig('policy')}>Политики конфиденциальности</a>`,
                checked: true,
                value: 'policy',
                fieldName: 'ffield',
                checks: 'require'
            })

        div(class = `${i.cl}__field`)
            +checkbox-group({
                id: `${idForm}-brands`,
                name: 'brands',
                fieldName: 'ffield',
                showCaption: true,
                className: 'checkbox',
                caption: 'checkbox тест',
                list: [
                    {name: 'Фильтр 1', checked: true},
                    {name: 'Фильтр 2'},
                    {name: 'Фильтр 3', value: 'filter3'}
                ]
            })

        div(class = `${i.cl}__field`)
            +checkbox-group({
                id: `${idForm}-checkbox-btn-1`,
                name: 'checkbox-btn-1',
                fieldName: 'ffield',
                showCaption: true,
                className: 'checkbox-btn',
                caption: 'checkbox-btn тест',
                list: [
                    {name: 'Фильтр2 1'},
                    {name: 'Фильтр2 2'},
                    {name: 'Фильтр2 3', value: 'filter3'}
                ]
            })

        div(class = `${i.cl}__field`)
            +checkbox-group({
                id: `${idForm}-checkbox-img-1`,
                name: 'checkbox-img-1',
                fieldName: 'ffield',
                showCaption: true,
                className: 'checkbox-img',
                caption: 'checkbox-img тест',
                list: [
                    {image: 'no-photo.jpg', name: 'radiobox-img 1'},
                    {image: 'no-photo.jpg', name: 'radiobox-img 2'},
                    {image: 'no-photo.jpg', name: 'radiobox-img 3'},
                    {image: 'no-photo.jpg', name: 'radiobox-img 4'},
                    {image: 'no-photo.jpg', name: 'radiobox-img 5'}
                ]
            })

        div(class = `${i.cl}__field`)
            +checkbox-group({
                id: `${idForm}-checkbox-2`,
                name: 'checkbox-2',
                fieldName: 'ffield',
                showCaption: true,
                checks: 'require',
                className: 'checkbox',
                caption: 'radiobox тест',
                typeGroup: 'radiobox',
                necessary: true,
                dopClasses: 'checkbox--radio',
                list: [
                    {name: 'Да', checked: true},
                    {name: 'Нет'},
                    {name: 'Нужна консультация'}
                ]
            })

        div(class = `${i.cl}__field`)
            +checkbox-group({
                id: `${idForm}-checkbox-btn-2`,
                name: 'checkbox-btn-2',
                fieldName: 'ffield',
                showCaption: true,
                className: 'checkbox-btn',
                caption: 'radiobox-btn тест',
                typeGroup: 'radiobox',
                list: [
                    {name: 'Да'},
                    {name: 'Нет'},
                    {name: 'Нужна консультация'}
                ]
            })

        div(class = `${i.cl}__field`)
            +checkbox-group({
                id: `${idForm}-checkbox-img-2`,
                name: 'checkbox-img-2',
                fieldName: 'ffield',
                showCaption: true,
                checks: 'require',
                className: 'checkbox-img',
                caption: 'radiobox-img тест',
                typeGroup: 'radiobox',
                list: [
                    {image: 'no-photo.jpg', name: 'radiobox-img 1', checked: true},
                    {image: 'no-photo.jpg', name: 'radiobox-img 2'},
                    {image: 'no-photo.jpg', name: 'radiobox-img 3'},
                    {image: 'no-photo.jpg', name: 'radiobox-img 4'},
                    {image: 'no-photo.jpg', name: 'radiobox-img 5'}
                ]
            })
        a.button(id=`${idForm}-send`) Отправить