mixin radiobox-group(i)
    - var id = i.id ? i.id : ''
    - var className = i.className ? `${i.className}-group` : 'radiobox-group'
    - var classRadiobox = i.className ? `${i.className}` : 'radiobox'
    div(class = `${className} field-container` + (i.checks ? ' error-watch' : ''))&attributes(attributes)
        input(
            id=`${id}`
            class=`${className}__edit ${i.fieldName}`
            type='hidden' hidden
            name=`${i.name}`
            value=''
            data-checks = `` + (i.checks ? i.checks : '')
            data-type = `radiobox-group`
            data-caption = '' + (i.caption ? i.caption : '')
        )
        each itemList, keyList in i.list 
            - 
                params = {
                    id: `${id}-${keyList + 1}`,
                    name: `${id}`,
                    caption: `${itemList.name}`,
                    checked: itemList.checked,
                    value: '' + (itemList.value ? itemList.value : itemList.name),
                    fieldName: '',
                    className: `${classRadiobox}`,
                    showCaption: !!i.showCaption
                }
            case i.className
                when 'radiobox'
                    div(class = `${className}__item`)
                        +radiobox(params)
                when 'radiobox-img'
                    -
                        params.image = `${itemList.image}`
                    div(class = `${className}__item`)
                        +radiobox-img(params)
                when 'radiobox-btn'
                    div(class = `${className}__item`)
                        +radiobox-btn(params)