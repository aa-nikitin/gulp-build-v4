mixin checkbox-group(i)
    - var id = i.id ? i.id : ''
    - var className = i.className ? `${i.className}-group` : 'checkbox-group'
    - var classCheckbox = i.className ? `${i.className}` : 'checkbox'
    - var dopClasses = i.dopClasses ? `${i.dopClasses}` : ''
    - var typeGroup = i.typeGroup ? i.typeGroup : 'checkbox';
    - var necessary = i.necessary ? '1' : '';
    div(class = `${className} field-container field-group-container` + (i.checks ? ' error-watch' : '') data-type-group=`${typeGroup}` data-necessary=`${necessary}`)&attributes(attributes)
        input(
            id=`${id}`
            class=`${className}__edit ${i.fieldName}`
            type='hidden' hidden
            name=`${i.name}`
            value=''
            data-checks = `` + (i.checks ? i.checks : '')
            data-type = `checkbox-group`
            data-caption = '' + (i.caption ? i.caption : '')
        )
        each itemList, keyList in i.list 
            - 
                params = {
                    id: `${id}-${keyList + 1}`,
                    name: `${id}`,
                    caption: `${itemList.name}`,
                    checked: itemList.checked,
                    value: '' + (itemList.value ? itemList.value : itemList.name),
                    fieldName: '',
                    className: `${classCheckbox}`,
                    dopClasses: `${dopClasses}`,
                    showCaption: !!i.showCaption
                }
            case i.className
                when 'checkbox'
                    div(class = `${className}__item`)
                        +checkbox(params)
                when 'checkbox-img'
                    -
                        params.image = `${itemList.image}`
                    div(class = `${className}__item`)
                        +checkbox-img(params)
                when 'checkbox-btn'
                    div(class = `${className}__item`)
                        +checkbox-btn(params)